# Blue lane-split road sign
mtllib sign.mtl
o sign
v -0.5000 0.0000 0.0200
v 0.5000 0.0000 0.0200
v 0.5000 1.0000 0.0200
v -0.5000 1.0000 0.0200
v -0.5000 0.0000 -0.0200
v 0.5000 0.0000 -0.0200
v 0.5000 1.0000 -0.0200
v -0.5000 1.0000 -0.0200
vt 0.0000 0.0000
vt 1.0000 0.0000
vt 1.0000 1.0000
vt 0.0000 1.0000
vt 0.0100 0.0100
vn 0.0 0.0 1.0
vn 0.0 0.0 -1.0
vn -1.0 0.0 0.0
vn 1.0 0.0 0.0
vn 0.0 1.0 0.0
vn 0.0 -1.0 0.0
usemtl sign_front
f 1/1/1 2/2/1 3/3/1 4/4/1
usemtl sign_side
f 6/5/2 5/5/2 8/5/2 7/5/2
f 5/5/3 1/5/3 4/5/3 8/5/3
f 2/5/4 6/5/4 7/5/4 3/5/4
f 4/5/5 3/5/5 7/5/5 8/5/5
f 5/5/6 6/5/6 2/5/6 1/5/6
